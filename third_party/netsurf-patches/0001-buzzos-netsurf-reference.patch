@@ -478,8 +478,17 @@ bool html_css_process_link(html_content *htmlc, dom_node *node)
 
 	nsurl_unref(joined);
 
-	if (ns_error != NSERROR_OK)
-		goto no_memory;
+	if (ns_error != NSERROR_OK) {
+		/* An author stylesheet is optional.  Failure to start its fetch
+		 * (for example, an HTTPS URL on a frontend without TLS support)
+		 * must not turn the parent HTML document into an error page.  Only
+		 * allocation failure is fatal to conversion. */
+		if (ns_error == NSERROR_NOMEM)
+			goto no_memory;
+		NSLOG(netsurf, WARNING, "Skipping unavailable stylesheet: %d",
+		      ns_error);
+		return true;
+	}
 
 	htmlc->stylesheet_count++;
 
